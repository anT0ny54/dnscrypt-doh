# SnapDeploy manages PORT automatically. Defaults are already optimized for
# the 512 MB / 0.25 vCPU Small container.
# Baseline: 99 requests/60s per IP, 10,000 tracked client IPs,
# 8 concurrent requests, and 4 KiB DNS messages. If compatibility
# requires larger DNS messages, MAX_DNS_MESSAGE_BYTES may be raised to 8192.
PORT=8080
DOH_PATH=/dns-query
RATE_LIMIT=99
RATE_WINDOW_SECONDS=60
MAX_DNS_MESSAGE_BYTES=4096
MAX_CONCURRENCY=8
MAX_CLIENT_IPS=10000
TRUST_PROXY_HEADERS=true
