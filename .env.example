# Defaults are optimized for the 512 MB / 0.25 vCPU Small container.
# Compose publishes the port directly, so local runs must not trust
# caller-supplied forwarding headers unless a trusted proxy overwrites them.
# The image itself defaults TRUST_PROXY_HEADERS=true for SnapDeploy.
# Baseline: 99 requests/60s per IP, 8,192 tracked client IPs,
# 8 concurrent requests, and 8 KiB DNS messages.
PORT=8080
DOH_PATH=/dns-query
RATE_LIMIT=99
RATE_WINDOW_SECONDS=60
MAX_DNS_MESSAGE_BYTES=8192
MAX_CONCURRENCY=8
MAX_CLIENT_IPS=8192
TRUST_PROXY_HEADERS=false
