# SnapDeploy manages PORT automatically. Defaults are already optimized for
# the 512 MB / 0.25 vCPU Small container.
PORT=8080
DOH_PATH=/dns-query
DOH_UPSTREAM=http://127.0.0.1:8053/dns-query
RATE_LIMIT=99
RATE_WINDOW_SECONDS=60
MAX_DNS_MESSAGE_BYTES=65535
MAX_CONCURRENCY=128
MAX_CLIENT_IPS=250000
TRUST_PROXY_HEADERS=true
