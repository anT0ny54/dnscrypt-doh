# Optional local overrides for docker compose. Copy to .env to use them.
#
# Only PORT and TRUST_PROXY_HEADERS are active. Compose and the image already
# set them, and they are the two values a local run must consciously choose.
# Every other setting is commented out at the gateway's built-in default from
# main.go, so the template cannot drift from the code. Uncomment one only to
# change it.
#
# Compose publishes the port directly, so local runs must not trust
# caller-supplied forwarding headers unless a trusted proxy overwrites them.
# The image itself defaults TRUST_PROXY_HEADERS=true for SnapDeploy.
PORT=8080
TRUST_PROXY_HEADERS=false

# DOH_PATH=/dns-query
# RATE_LIMIT=99
# RATE_WINDOW_SECONDS=60
# MAX_DNS_MESSAGE_BYTES=8192
# MAX_CONCURRENCY=16
# MAX_CLIENT_IPS=8192
